FROM python:3.12-slim

WORKDIR /src

# Install the Python SDK (Hermes depends on it)
COPY sdks/python /src/sdks/python
RUN pip install --no-cache-dir /src/sdks/python

# Install Hermes itself
COPY skills/hermes /src/skills/hermes

ENV PYTHONPATH=/src/skills:/src/sdks/python/src

# Hermes periodically ingests the Guardian's shared JSONL trace log and then
# reflects over the resulting sessions.
COPY <<'SCRIPT' /usr/local/bin/hermes-loop
#!/bin/bash
set -euo pipefail

while true; do
    echo "[$(date -Iseconds)] Hermes ingest + reflection pass"
    python3 -m hermes.cli \
        --vault "$TRUSTLAYER_VAULT_PATH" \
        ingest "$TRUSTLAYER_EVENTS_PATH" --reflect 2>&1 || true
    sleep "${HERMES_INTERVAL:-3600}"
done
SCRIPT

RUN chmod +x /usr/local/bin/hermes-loop

CMD ["hermes-loop"]
