# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-slim AS build

WORKDIR /src
COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# Inject build-time env vars from ARGs
ARG VITE_TRUSTLAYER_BASE_URL=http://localhost:8089
ARG VITE_TRUSTLAYER_API_TOKEN=
ENV VITE_TRUSTLAYER_BASE_URL=$VITE_TRUSTLAYER_BASE_URL \
    VITE_TRUSTLAYER_API_TOKEN=$VITE_TRUSTLAYER_API_TOKEN

RUN npm run build

# ── Runtime stage ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=build /src/dist /usr/share/nginx/html

# SPA routing: all paths serve index.html
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

EXPOSE 80
