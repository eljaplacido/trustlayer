{
  "name": "@trustlayer/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for TrustLayer observability and governance.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/eljaplacido/trustlayer",
  "repository": {
    "type": "git",
    "url": "https://github.com/eljaplacido/trustlayer.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/eljaplacido/trustlayer/issues"
  },
  "keywords": [
    "trustlayer",
    "agent",
    "observability",
    "governance",
    "ai"
  ],
  "type": "module",
